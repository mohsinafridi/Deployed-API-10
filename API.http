@API_HostAddress = http://localhost:5056

### List all users
GET {{API_HostAddress}}/users
Accept: application/json

### Get one user
GET {{API_HostAddress}}/users/1
Accept: application/json

### Create a user
POST {{API_HostAddress}}/users
Content-Type: application/json

{
  "name": "New User",
  "email": "new.user@example.com"
}

### Update a user
PUT {{API_HostAddress}}/users/1
Content-Type: application/json

{
  "name": "Updated Name",
  "email": "updated@example.com"
}

### Delete a user
DELETE {{API_HostAddress}}/users/4

### List products
GET {{API_HostAddress}}/products
Accept: application/json

### Create a product
POST {{API_HostAddress}}/products
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "price": 350.00,
  "stock": 60
}

### List orders (with user + product details)
GET {{API_HostAddress}}/orders
Accept: application/json

### Create an order
POST {{API_HostAddress}}/orders
Content-Type: application/json

{
  "userId": 1,
  "productId": 2,
  "quantity": 3
}
